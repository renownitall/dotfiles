# Palette and mode come from meta/color-scheme.md. The applied copy is generated from this template.
# {{- $p := .palette }}
font=SauceCodePro Nerd Font Mono:size=8
icon-theme=Papirus{{ if eq .mode "light" }}-Light{{ else }}-Dark{{ end }}
width=56
anchor=center
minimal-lines=yes
horizontal-pad=16
inner-pad=8
prompt=" "
placeholder="find something..."

[colors]
background={{ $p.base.hex }}FF
text={{ $p.text.hex }}FF
message={{ $p.muted.hex }}FF
prompt={{ $p.muted.hex }}FF
placeholder={{ $p.muted.hex }}FF
input={{ $p.text.hex }}FF
match={{ $p.blue_bright.hex }}FF
selection={{ $p.selection_deep.hex }}FF
selection-text={{ $p.text_max.hex }}FF
selection-match={{ $p.blue_bright.hex }}FF
counter={{ $p.muted.hex }}FF
border={{ $p.line.hex }}FF

[border]
width=1
radius=4

[main]
namespace = launcher

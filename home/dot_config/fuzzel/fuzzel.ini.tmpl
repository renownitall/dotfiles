# Managed by chezmoi. Edit the template in the dotfiles repository instead.
#{{ $c := .flint.resolved }}{{ $r := .flint.raw }}
#{{ $d := .flint.desktop }}
#{{ $a := .flint.appearance }}

font={{ $d.font_family_nerd }} Mono:size=8
icon-theme={{ $a.icon_theme }}
width=56
anchor=center
minimal-lines=yes
horizontal-pad=16
inner-pad=8
prompt=" "
placeholder="find something..."

[main]
namespace = launcher

[colors]
background={{ $r.background_primary.bare_ff }}
text={{ $r.text_normal.bare_ff }}
message={{ $r.text_normal.bare_ff }}
prompt={{ $r.text_normal.bare_ff }}
placeholder={{ $r.text_muted.bare_ff }}
input={{ $r.text_normal.bare_ff }}
match={{ $c.text_accent.bare_ff }}
selection={{ $r.background_modifier_hover.bare_ff }}
selection-text={{ $r.text_normal.bare_ff }}
selection-match={{ $c.text_accent.bare_ff }}
counter={{ $r.text_muted.bare_ff }}
border={{ $c.window_focused_border.bare_ff }}

[border]
width=1
radius={{ $d.corner_radius }}

# vim: ft=dosini

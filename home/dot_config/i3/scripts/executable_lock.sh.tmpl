#!/usr/bin/env sh
set -eu

# Requires i3lock-color (its binary is `i3lock`), imagemagick,
# notify-send, dunstctl.{{ $p := .palette }}

# xss-lock sets XSS_SLEEP_LOCK_FD only when it locks because the system
# is about to sleep. That path skips the notify/delay because suspend
# waits on the fd. The manual and idle paths keep the "locking
# screen..." beat before locking. It is the idle countdown's finale,
# at sway's timing (notify+delay on the idle timeout path there too).
before_sleep=0
if [ -n "${XSS_SLEEP_LOCK_FD:-}" ] && [ -e "/dev/fd/$XSS_SLEEP_LOCK_FD" ]; then
	before_sleep=1
fi

if [ "$before_sleep" -eq 0 ]; then
	# Timeout avoids hangs on backlogged dunst; -a lock matches dnd_bypass_lock.
	timeout 2 notify-send -a lock -u low -t 2500 " locking screen..." || true
	sleep 2.5
fi

# Pause at 100 (above the 90 bypasses); save the level for restore.
# Timeouts keep a hanging daemon from blocking suspend.
pause_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dunst_pause_before_lock"
# First instance records the pre-lock level; an overlapping locker would
# record the already-paused 100 and strand DND after unlock.
pause_owner=0
if [ ! -f "$pause_file" ]; then
	timeout 2 dunstctl get-pause-level 2>/dev/null >"$pause_file" || echo 0 >"$pause_file"
	pause_owner=1
fi
timeout 2 dunstctl set-pause-level 100 2>/dev/null || true

# Per-instance name so an overlapping locker cannot truncate a capture
# i3lock is already reading.
lockimg="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/i3lock_bg_$$.png"
timeout 3 import -window root "$lockimg" 2>/dev/null || true

# Downscale first to keep CPU and IO use low.
if command -v magick >/dev/null 2>&1; then
	timeout 3 magick "$lockimg" -scale 33% -blur 0x8 -fill black -colorize 20% "$lockimg" 2>/dev/null || true
elif command -v convert >/dev/null 2>&1; then
	timeout 3 convert "$lockimg" -scale 33% -blur 0x8 -fill black -colorize 20% "$lockimg" 2>/dev/null || true
fi

cleanup() {
	# Restore the pre-lock level instead of unpausing, so DND stays on.
	if [ "$pause_owner" -eq 1 ]; then
		restore_level=0
		if [ -f "$pause_file" ]; then
			restore_level=$(tr -cd '0-9' <"$pause_file" 2>/dev/null || true)
			[ -n "$restore_level" ] || restore_level=0
			rm -f "$pause_file"
		fi
		timeout 2 dunstctl set-pause-level "$restore_level" 2>/dev/null || true
		timeout 2 dunstctl close-all 2>/dev/null || true
	fi
	rm -f "$lockimg"
}

run_lock() {
	# Colors are rrggbbaa without a leading hash; the palette exports the bare form.
	# Media and brightness keys pass through while locked, mirroring sway --locked.
	# Without --fill i3lock draws the capture at native size, top-left.
	i3lock --nofork \
		--image "$lockimg" \
		--fill \
		--indicator \
		--radius 84 \
		--ring-width 3 \
		--clock \
		--time-str "%R" \
		--date-str "%a, %e %b" \
		--time-font "SauceCodePro Nerd Font Mono" \
		--date-font "SauceCodePro Nerd Font Mono" \
		--verif-font "SauceCodePro Nerd Font Mono" \
		--wrong-font "SauceCodePro Nerd Font Mono" \
		--time-size 18 \
		--date-size 14 \
		--verif-size 14 \
		--wrong-size 14 \
		--ignore-empty-password \
		--show-failed-attempts \
		--pass-media-keys \
		--pass-screen-keys \
		--inside-color={{ $p.base.bare }}FF \
		--insidever-color={{ $p.base.bare }}FF \
		--insidewrong-color={{ $p.base.bare }}FF \
		--ring-color={{ $p.line.bare }}FF \
		--ringver-color={{ $p.yellow.bare }}FF \
		--ringwrong-color={{ $p.red.bare }}FF \
		--line-color={{ $p.black.bare }}00 \
		--separator-color={{ $p.black.bare }}00 \
		--keyhl-color={{ $p.text.bare }}FF \
		--bshl-color={{ $p.red_bright.bare }}FF \
		--verif-color={{ $p.text.bare }}FF \
		--wrong-color={{ $p.red.bare }}FF \
		--time-color={{ $p.text.bare }}FF \
		--date-color={{ $p.text.bare }}FF
}

# xss-lock gates sleep on the fd, not this process: i3lock must not
# inherit a copy (it never closes one), and closing ours releases
# logind instead of waiting out InhibitDelayMaxSec.
if [ -n "${XSS_SLEEP_LOCK_FD:-}" ] && [ -e "/dev/fd/$XSS_SLEEP_LOCK_FD" ]; then
	(
		eval "exec ${XSS_SLEEP_LOCK_FD}>&-"
		run_lock
	) &
else
	run_lock &
fi
lock_pid=$!
if [ -n "${XSS_SLEEP_LOCK_FD:-}" ] && [ -e "/dev/fd/$XSS_SLEEP_LOCK_FD" ]; then
	eval "exec ${XSS_SLEEP_LOCK_FD}>&-"
fi
# xss-lock re-runs the locker only after the previous one exits. A
# forced unlock TERMs us, which the trap turns into killing i3lock.
# `wait || true` keeps set -e from skipping cleanup on a failed locker,
# which would strand dunst at pause level 100.
trap 'pkill -x -u "$(id -u)" i3lock 2>/dev/null || true' TERM INT
wait "$lock_pid" || true
cleanup

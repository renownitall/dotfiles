# meta/color-scheme.md defines the palette, and the color values in this
# config are locked to it.
# {{- $p := .palette }}
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu rofi
set $browser $HOME/.config/i3/scripts/wrapper_browser.sh
set $filemanager sh -c 'exec ${FILE_MANAGER:-thunar}'
set $passwordmanager sh -c 'QT_QPA_PLATFORMTHEME=qt5ct exec ${PASSWORD_MANAGER:-keepassxc}'

font pango:SauceCodePro Nerd Font Mono 8

tiling_drag modifier titlebar
popup_during_fullscreen smart

floating_modifier $mod

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+o splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+p layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space exec $HOME/.config/i3/scripts/toggle_floating.sh
bindsym $mod+space focus mode_toggle
bindsym $mod+c move position center
bindsym $mod+q kill

bindsym $mod+Return exec $term
bindsym --release $mod+d exec $menu -show drun
bindsym $mod+b exec $browser
bindsym $mod+e exec $filemanager
bindsym $mod+Shift+p exec $passwordmanager
bindsym $mod+Shift+v exec pavucontrol --tab=3
bindsym $mod+Shift+b exec blueman-manager

bindsym --release $mod+Shift+i exec $HOME/.config/i3/scripts/toggle_idle.sh

bindsym Print exec flameshot full -p $HOME/Pictures/Screenshots -c
bindsym Ctrl+Print exec $HOME/.config/i3/scripts/flameshot_window.sh
bindsym Shift+Print exec $HOME/.config/i3/scripts/flameshot_gui.sh

bindsym XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioStop exec playerctl stop

bindsym $mod+Shift+minus floating enable, border normal, resize set width 75 ppt height 70 ppt, move position center, move scratchpad
bindsym $mod+minus exec $HOME/.config/i3/scripts/cycle_scratchpad.sh

bindsym --release $mod+grave exec $HOME/.config/i3/scripts/toggle_drop_term.sh

bindsym $mod+n exec dunstctl close
bindsym $mod+Shift+n exec dunstctl close-all
bindsym --release $mod+Shift+d exec $HOME/.config/polybar/scripts/dunst-dnd.sh --toggle

bindsym --release $mod+Shift+t exec --no-startup-id $HOME/.local/bin/palette-mode toggle

bindsym $mod+Shift+c reload, exec --no-startup-id polybar-msg cmd restart

bindsym $mod+Shift+x exec $HOME/.config/i3/scripts/lock.sh

bindsym $mod+Shift+BackSpace exec $HOME/.config/i3/scripts/power_control.sh poweroff
bindsym $mod+Shift+r exec $HOME/.config/i3/scripts/power_control.sh reboot
bindsym $mod+Shift+z exec $HOME/.config/i3/scripts/power_control.sh suspend
bindsym $mod+Shift+e exec $HOME/.config/i3/scripts/power_control.sh logout

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

for_window [class="(?i)pavucontrol"] floating enable, border normal, resize set width 40 ppt height 45 ppt, move position center
for_window [class="Blueman-manager"] floating enable, border normal, resize set width 30 ppt height 40 ppt, move position center
for_window [class="(?i)polkit-gnome-authentication-agent-1"] floating enable, border normal, move position center
for_window [window_role="GtkFileChooserDialog"] floating enable, resize set width 70 ppt height 70 ppt, move position center
for_window [instance="scratchpad_term"] floating enable, border normal, resize set width 75 ppt height 70 ppt, mark drop_term, move scratchpad, scratchpad show, move position center
for_window [instance="topgrade_term"] floating enable, border normal, resize set width 75 ppt height 70 ppt, mark topgrade_term, move scratchpad, scratchpad show, move position center
for_window [instance="btop"] floating enable, border normal, resize set width 75 ppt height 70 ppt, move position center

client.focused           {{ $p.line.hex }} {{ $p.surface_1.hex }} {{ $p.text.hex }} {{ $p.line.hex }} {{ $p.line.hex }}
client.focused_inactive  {{ $p.surface_2.hex }} {{ $p.base.hex }} {{ $p.muted.hex }} {{ $p.surface_2.hex }} {{ $p.surface_2.hex }}
client.focused_tab_title {{ $p.line.hex }} {{ $p.surface_1.hex }} {{ $p.text.hex }}
client.unfocused         {{ $p.surface_2.hex }} {{ $p.base.hex }} {{ $p.muted.hex }} {{ $p.surface_2.hex }} {{ $p.surface_2.hex }}
client.urgent            {{ $p.red_bright.hex }} {{ $p.urgent.hex }} {{ $p.text_max.hex }} {{ $p.red_bright.hex }} {{ $p.red_bright.hex }}
client.placeholder       {{ $p.base.hex }} {{ $p.base.hex }} {{ $p.muted.hex }} {{ $p.base.hex }} {{ $p.base.hex }}
client.background        {{ $p.base.hex }}

default_border pixel 1
hide_edge_borders none

gaps inner 5
gaps outer 3

exec $HOME/.config/i3/scripts/autostart.sh

exec --no-startup-id xset s 20 10
exec --no-startup-id xset dpms 90 90 90
exec --no-startup-id xss-lock --notifier=$HOME/.config/i3/scripts/idle_notifier.sh --transfer-sleep-lock -- $HOME/.config/i3/scripts/lock.sh

exec --no-startup-id picom --config $HOME/.config/picom.conf
exec --no-startup-id $HOME/.fehbg

exec --no-startup-id mkdir -p $HOME/Pictures/Screenshots

exec_always --no-startup-id $HOME/.config/i3/scripts/applets.sh

/* Locked scheme (meta/color-scheme.md); all vars referenced. Managed by
   chezmoi; edit the .tmpl source. */{{ $p := .palette }}

@define-color neutral-base {{ $p.base.hex }};
@define-color neutral-text {{ $p.text.hex }};
@define-color neutral-text-subtext {{ $p.subtext.hex }};
@define-color neutral-surface-0 {{ $p.surface_0.hex }};
@define-color neutral-text-max {{ $p.text_max.hex }};
@define-color neutral-text-muted {{ $p.muted.hex }};
@define-color neutral-border-inactive {{ $p.surface_2.hex }};
@define-color neutral-focus-border {{ $p.line.hex }};
@define-color neutral-accent-text {{ $p.blue.hex }};
@define-color neutral-accent-bright {{ $p.blue_bright.hex }};
@define-color neutral-surface-1 {{ $p.surface_1.hex }};
@define-color neutral-warning {{ $p.yellow.hex }};
@define-color neutral-error-text {{ $p.red.hex }};
@define-color neutral-error-bright {{ $p.red_bright.hex }};
@define-color neutral-transparent {{ $p.transparent.rgba }};
@define-color neutral-hover-neutral {{ $p.hover.rgba }};
@define-color neutral-hover-warning {{ $p.warning_hover.hex }};
@define-color neutral-hover-error {{ $p.error_hover.hex }};

* {
  border: none;
  border-radius: 0;
  font-family: "Source Code Pro", "SauceCodePro Nerd Font Mono", monospace;
  font-size: 12px;
  min-height: 0;
}

window#waybar {
  background-color: @neutral-base;
  color: @neutral-text;
}

/* --- Workspaces --- */
#workspaces {
  margin: 0;
  padding: 0 2px;
}

#workspaces button label {
  font-size: 16px;
}

#workspaces button {
  padding: 0 6px;
  margin: 0;
  border: none;
  border-bottom: 1px solid @neutral-transparent;
  color: @neutral-text-muted;
  background: transparent;
  background-image: none;
  box-shadow: none;
  text-shadow: none;
  min-width: 0;
  min-height: 0;
  transition:
    color 120ms ease,
    background-color 120ms ease,
    border-color 120ms ease;
}

#workspaces button:hover {
  color: @neutral-text-max;
  background-color: @neutral-hover-neutral;
  border-bottom-color: @neutral-border-inactive;
}

#workspaces button.focused {
  color: @neutral-accent-text;
}

#workspaces button.focused:hover {
  color: @neutral-accent-bright;
}

#workspaces button.urgent {
  color: @neutral-error-text;
  border-bottom-color: @neutral-error-text;
}

#workspaces button.urgent:hover {
  color: @neutral-error-bright;
  background-color: @neutral-hover-error;
  border-bottom-color: @neutral-error-text;
}

#mode {
  padding: 0 8px;
  margin: 1px 4px;
  background-color: @neutral-hover-warning;
  color: @neutral-warning;
  border: 1px solid @neutral-warning;
  font-weight: bold;
}

/* --- Shared --- */
#battery,
#clock,
#cpu,
#custom-dnd,
#custom-mpris,
#custom-updates,
#memory,
#pulseaudio,
#tray {
  padding: 0 8px;
  margin: 1px;
  color: @neutral-text;
  background-color: @neutral-transparent;
  border: 1px solid @neutral-transparent;
  opacity: 1;
  transition:
    color 120ms ease,
    background-color 120ms ease,
    border-color 120ms ease;
}

#battery:hover,
#clock:hover,
#cpu:hover,
#custom-dnd:hover,
#custom-mpris:hover,
/* Zero-updates state is dimmed, mirroring polybar's topgrade module. */
#custom-updates.ok {
  color: @neutral-text-muted;
}

#custom-updates:hover,
#memory:hover,
#pulseaudio:hover {
  color: @neutral-text-max;
  background-color: @neutral-hover-neutral;
  border-color: @neutral-border-inactive;
}

/* --- MPRIS (custom/mpris module; muted until playing) --- */
#custom-mpris {
  color: @neutral-text-muted;
}

/* --- Updates (custom/updates module; warning only when updates exist) --- */
#custom-updates.has-updates {
  color: @neutral-warning;
}

#custom-updates.has-updates:hover {
  background-color: @neutral-hover-warning;
  border-color: @neutral-warning;
}

/* --- DND (custom/dnd module; error tint while silenced) --- */
#custom-dnd.enabled {
  color: @neutral-error-text;
}

#custom-dnd.enabled:hover {
  background-color: @neutral-hover-error;
  border-color: @neutral-error-text;
}

/* --- Separator --- */
#custom-separator {
  padding: 0 0 2px;
  margin: 0;
  color: @neutral-text-muted;
}

/* --- Window Title --- */
#window {
  padding: 0 12px;
  margin: 1px;
  color: @neutral-text-subtext;
  background-color: @neutral-transparent;
  border: 1px solid @neutral-transparent;
  font-size: 12px;
  transition:
    color 200ms ease,
    background-color 120ms ease,
    border-color 120ms ease;
}

#window image {
  padding: 0 4px;
}

#window:hover {
  color: @neutral-text-max;
  background-color: @neutral-hover-neutral;
  border-color: @neutral-border-inactive;
}

/* --- Battery States --- */
#battery.warning {
  color: @neutral-warning;
}

#battery.warning:hover {
  background-color: @neutral-hover-warning;
  border-color: @neutral-warning;
}

#battery.critical {
  color: @neutral-error-text;
}

#battery.critical:hover {
  background-color: @neutral-hover-error;
  border-color: @neutral-error-text;
}

/* --- Tray & Tooltips --- */
#tray {
  padding: 0 4px;
}

#tray > widget {
  padding: 0 6px;
  transition: border-bottom 120ms ease;
  border-bottom: 1px solid @neutral-transparent;
}

#tray > widget:hover {
  border-bottom-color: @neutral-border-inactive;
}

#tray menu {
  background-color: @neutral-surface-0;
  color: @neutral-text;
  border: 1px solid @neutral-focus-border;
  border-radius: 4px;
}

tooltip {
  background-color: @neutral-surface-0;
  color: @neutral-text;
  border: 1px solid @neutral-focus-border;
  /* Rounding the tooltip produces black corner artifacts. */
  /* border-radius: 4px; */
}

#tray menu menuitem {
  padding: 0;
  margin: 0;
  color: @neutral-text;
}

#tray menu menuitem:hover {
  background-color: @neutral-surface-1;
  color: @neutral-text-max;
  border-color: @neutral-surface-1;
}

#tray menu menuitem:disabled {
  color: @neutral-text-muted;
  background-color: @neutral-transparent;
  border-color: @neutral-transparent;
}

#tray menu separator {
  background-color: @neutral-transparent;
  min-height: 0;
  margin: 0;
}

tooltip label {
  background-color: @neutral-transparent;
  color: @neutral-text;
  padding: 4px 8px;
}

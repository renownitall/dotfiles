# Palette comes from meta/color-scheme.md. The applied copy is generated from this template.
# {{- $p := .palette }}
backend = "glx";
vsync = true;
use-damage = true;
xrender-sync-fence = true;

blur-method = "dual_kawase";
blur-strength = 5;
blur-background = true;

shadow = true;
shadow-radius = 14;
shadow-offset-x = 0;
shadow-offset-y = 2;
shadow-color = "{{ $p.black.hex }}";
shadow-opacity = 0.4;

corner-radius = 4;

detect-client-opacity = true;
detect-transient = true;
detect-client-leader = true;

rules: ({
  match = "window_type = 'tooltip'";
  fade = false;
  corner-radius = 8;
}, {
  match = "_GTK_FRAME_EXTENTS@";
  blur-background = false;
  shadow = false;
}, {
  match = "window_type = 'dock' || window_type = 'desktop'";
  blur-background = false;
  shadow = false;
  corner-radius = 0;
}, {
  match = "class_g = 'i3-frame'";
  shadow = false;
})

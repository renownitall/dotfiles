# Managed by chezmoi. Edit the template in the dotfiles repository instead.
#{{ $c := .flint.resolved }}{{ $r := .flint.raw }}
#{{ $d := .flint.desktop }}
#{{ $al := .flint.alpha }}

# --- Font ---
set font "{{ $d.font_family }} normal {{ $d.font_size }}"


# --- Base UI ---
set default-bg "{{ $r.background_primary.hex }}"
set default-fg "{{ $r.text_normal.hex }}"

# --- Completion ---
set completion-bg "{{ $r.background_modifier_form_field.hex }}"
set completion-group-fg "{{ $r.text_muted.hex }}"
set completion-group-bg "{{ $r.background_modifier_hover.hex }}"
set completion-highlight-bg "{{ $r.selection_wash.hex }}"
set completion-highlight-fg "{{ $r.text_normal.hex }}"

# --- Inputbar ---
set inputbar-bg "{{ $r.background_modifier_hover.hex }}"
set inputbar-fg "{{ $r.text_normal.hex }}"

# --- Notifications ---
set notification-bg "{{ $r.selection_wash.hex }}"
set notification-fg "{{ $r.text_normal.hex }}"
set notification-error-bg "{{ $r.critical_bg.hex }}"
set notification-error-fg "{{ $c.on_accent.hex }}"
set notification-warning-bg "{{ $c.warning.hex }}"
set notification-warning-fg "{{ $r.background_primary.hex }}"

# --- Statusbar ---
set statusbar-bg "{{ $r.background_modifier_hover.hex }}"
set statusbar-fg "{{ $r.text_normal.hex }}"
set statusbar-h-padding 10
set statusbar-v-padding 4

# --- Index / table of contents ---
set index-bg "{{ $r.background_modifier_hover.hex }}"
set index-fg "{{ $r.text_normal.hex }}"
set index-active-bg "{{ $r.selection_wash.hex }}"
set index-active-fg "{{ $r.text_normal.hex }}"

# --- Page rendering ---
set page-v-padding 8
set page-h-padding 8
set render-loading-bg "{{ $r.background_primary.hex }}"
set render-loading-fg "{{ $r.text_muted.hex }}"

# --- Search and highlights ---
set highlight-color "{{ $al.border_40.hex }}"
set highlight-active-color "{{ $al.search_35.hex }}"

# --- Recoloring / dark PDF mode ---
map <C-r> set recolor
set recolor true
set recolor-reverse-video true
set recolor-lightcolor "{{ $r.background_primary.hex }}"
set recolor-darkcolor "{{ $r.text_normal.hex }}"

# --- Signature information ---
set show-signature-information true
set signature-success-color "{{ $al.success_90.hex }}"
set signature-warning-color "{{ $al.warning_90.hex }}"
set signature-error-color "{{ $al.error_90.hex }}"

# --- Small quality-of-life UI behavior ---
set adjust-open width
set selection-clipboard clipboard
set statusbar-basename true
set statusbar-page-percent true
set window-title-basename true
set window-title-page true

# vim: ft=zathurarc

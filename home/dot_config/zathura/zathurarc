# Locked scheme (meta/color-scheme.md).

set font "Source Sans 3 normal 10"

set default-bg "#202020"
set default-fg "#D4D4D4"

set completion-bg "#2D2D2D"
set completion-group-fg "#8A8A8A"
set completion-group-bg "#262626"
set completion-highlight-bg "#3A3A3A"
set completion-highlight-fg "#D4D4D4"

set inputbar-bg "#262626"
set inputbar-fg "#D4D4D4"

set notification-bg "#2D2D2D"
set notification-fg "#D4D4D4"
set notification-error-bg "#FE4864"
set notification-error-fg "#202020"
set notification-warning-bg "#F4BC45"
set notification-warning-fg "#D4D4D4"

set statusbar-bg "#2D2D2D"
set statusbar-fg "#D4D4D4"
set statusbar-h-padding 10
set statusbar-v-padding 4

set index-bg "#2D2D2D"
set index-fg "#D4D4D4"
set index-active-bg "#3A3A3A"
set index-active-fg "#D4D4D4"

set page-v-padding 8
set page-h-padding 8
set render-loading-bg "#202020"
set render-loading-fg "#8A8A8A"

# Accent 40% alpha, selection 35%.
set highlight-color "#48AFFF66"
set highlight-active-color "#2F3C4759"

map <C-r> set recolor
set recolor true
set recolor-reverse-video true
set recolor-lightcolor "#202020"
set recolor-darkcolor "#D4D4D4"

set show-signature-information true
set signature-success-color "#89C952E6"
set signature-warning-color "#F4BC45E6"
set signature-error-color "#FE4864E6"

set adjust-open width
set selection-clipboard clipboard
set statusbar-basename true
set statusbar-page-percent true
set window-title-basename true
set window-title-page true

# vim: ft=zathurarc

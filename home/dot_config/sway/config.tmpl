# Managed by chezmoi; edit the .tmpl source.{{ $p := .palette }}
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel
set $browser $HOME/.config/sway/scripts/wrapper_browser.sh
set $filemanager sh -c 'exec ${FILE_MANAGER:-thunar}'
set $passwordmanager sh -c 'QT_QPA_PLATFORMTHEME=qt5ct exec ${PASSWORD_MANAGER:-keepassxc}'

font pango:SauceCodePro Nerd Font Mono 8

floating_modifier $mod normal

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout.
bindsym $mod+o splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+p layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+c move position center
bindsym $mod+q kill

# Apps.
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec $browser
bindsym $mod+e exec $filemanager
bindsym $mod+Shift+p exec $passwordmanager
bindsym $mod+Shift+v exec pavucontrol --tab=3
bindsym $mod+Shift+b exec blueman-manager

# Caffeine toggle.
bindsym --no-repeat $mod+Shift+i exec $HOME/.config/sway/scripts/toggle_idle.sh

# Screenshots.
bindsym Print exec $HOME/.config/sway/scripts/screenshot.sh full
bindsym Ctrl+Print exec $HOME/.config/sway/scripts/screenshot.sh focused
bindsym Shift+Print exec $HOME/.config/sway/scripts/screenshot.sh region

# Media keys. Work while locked; they change output state, not session state.
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

# Scratchpad.
bindsym $mod+Shift+minus floating enable, border normal, resize set width 75 ppt height 70 ppt, move position center, move scratchpad
bindsym $mod+minus exec $HOME/.config/sway/scripts/cycle_scratchpad.sh

# Dropdown terminal.
bindsym --no-repeat $mod+grave exec $HOME/.config/sway/scripts/toggle_drop_term.sh

# Notifications.
bindsym $mod+n exec dunstctl close
bindsym $mod+Shift+n exec dunstctl close-all
bindsym --no-repeat $mod+Shift+d exec $HOME/.config/waybar/scripts/dunst-dnd.sh --toggle

# Reload.
bindsym $mod+Shift+c reload

# Lock.
bindsym $mod+Shift+x exec $HOME/.config/sway/scripts/lock.sh

# Power.
bindsym $mod+Shift+BackSpace exec $HOME/.config/sway/scripts/power_control.sh poweroff
bindsym $mod+Shift+r exec $HOME/.config/sway/scripts/power_control.sh reboot
bindsym $mod+Shift+z exec $HOME/.config/sway/scripts/power_control.sh suspend
bindsym $mod+Shift+e exec $HOME/.config/sway/scripts/power_control.sh logout

# Resize mode.
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Trackpad.
input type:touchpad {
    accel_profile flat
    pointer_accel 0.75
    natural_scroll enabled
    tap enabled
    dwt enabled
    scroll_method two_finger
    middle_emulation enabled
}

for_window [app_id="pavucontrol"] floating enable, border normal, resize set width 40 ppt height 45 ppt, move position center
for_window [app_id="blueman-manager"] floating enable, border normal, resize set width 30 ppt height 40 ppt, move position center
for_window [app_id="polkit-gnome-authentication-agent-1"] floating enable, border normal, move position center
for_window [app_id="satty"] floating enable, border normal, resize set width 90 ppt height 80 ppt, move position center
for_window [app_id="foot_drop"] floating enable, border normal, mark drop_term, resize set width 75 ppt height 70 ppt, move scratchpad, scratchpad show, move position center
for_window [app_id="foot_topgrade"] floating enable, border normal, mark topgrade_term, resize set width 75 ppt height 70 ppt, move scratchpad, scratchpad show, move position center

# Locked scheme (meta/color-scheme.md).
client.focused          {{ $p.line.hex }} {{ $p.surface_1.hex }} {{ $p.text.hex }} {{ $p.line.hex }} {{ $p.line.hex }}
client.focused_inactive {{ $p.surface_2.hex }} {{ $p.base.hex }} {{ $p.muted.hex }} {{ $p.surface_2.hex }} {{ $p.surface_2.hex }}
client.focused_tab_title {{ $p.line.hex }} {{ $p.surface_1.hex }} {{ $p.text.hex }}
client.unfocused        {{ $p.surface_2.hex }} {{ $p.base.hex }} {{ $p.muted.hex }} {{ $p.surface_2.hex }} {{ $p.surface_2.hex }}
# Dunst-critical treatment: urgent tint field, white text, red edges.
client.urgent           {{ $p.red_bright.hex }} {{ $p.urgent.hex }} {{ $p.text_max.hex }} {{ $p.red_bright.hex }} {{ $p.red_bright.hex }}
client.placeholder      {{ $p.base.hex }} {{ $p.base.hex }} {{ $p.muted.hex }} {{ $p.base.hex }} {{ $p.base.hex }}
client.background       {{ $p.base.hex }}

default_border pixel 1
hide_edge_borders smart

# SwayFX (static).
gaps inner 5
gaps outer 3

blur enable
blur_passes 3
blur_radius 5
blur_xray disable
shadows enable
shadow_blur_radius 14
shadow_color {{ $p.black.hex }}80
shadow_offset 0 2
shadow_inactive_color {{ $p.black.hex }}80
corner_radius 4
default_dim_inactive 0.05
# The launcher namespace must match fuzzel.ini, or the fuzzel shadow never applies.
layer_effects "launcher" {
    shadows enable;
}

exec $HOME/.config/sway/scripts/autostart.sh

exec_always blueman-applet
exec_always nm-applet --indicator

exec $HOME/.local/bin/sw --restore

bar {
    swaybar_command waybar
}

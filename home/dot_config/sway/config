set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel
set $browser sh -c 'exec ${BROWSER:-helium-browser}'
set $filemanager sh -c 'exec ${FILE_MANAGER:-thunar}'
set $passwordmanager sh -c 'QT_QPA_PLATFORMTHEME=qt5ct exec ${PASSWORD_MANAGER:-keepassxc}'

font pango:GoogleSansCode Nerd Font Mono 10

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout.
bindsym $mod+o splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+p layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+q kill

# Apps.
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec $browser
bindsym $mod+e exec $filemanager
bindsym $mod+Shift+p exec $passwordmanager
bindsym $mod+Shift+v exec pavucontrol --tab=3
bindsym $mod+Shift+b exec blueman-manager

# Caffeine toggle.
bindsym --no-repeat $mod+Shift+i exec $HOME/.config/sway/scripts/toggle_idle.sh

# Screenshots.
bindsym Print exec $HOME/.config/sway/scripts/screenshot.sh full
bindsym Ctrl+Print exec $HOME/.config/sway/scripts/screenshot.sh focused
bindsym Shift+Print exec $HOME/.config/sway/scripts/screenshot.sh region

# Scratchpad.
bindsym $mod+Shift+minus floating enable, border normal, resize set width 75 ppt height 70 ppt, move position center, move scratchpad
bindsym $mod+minus exec $HOME/.config/sway/scripts/cycle_scratchpad.sh

# Dropdown terminal.
bindsym --no-repeat $mod+grave exec $HOME/.config/sway/scripts/toggle_drop_term.sh

# Reload.
bindsym $mod+Shift+c reload

# Lock.
bindsym $mod+Shift+x exec $HOME/.config/sway/scripts/lock.sh

# Power.
bindsym $mod+Shift+BackSpace exec $HOME/.config/sway/scripts/power_control.sh poweroff
bindsym $mod+Shift+r exec $HOME/.config/sway/scripts/power_control.sh reboot
bindsym $mod+Shift+z exec $HOME/.config/sway/scripts/power_control.sh suspend
bindsym $mod+Shift+e exec $HOME/.config/sway/scripts/power_control.sh logout

# Resize mode.
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Trackpad.
input type:touchpad {
    accel_profile flat
    pointer_accel 0.75
    natural_scroll enabled
    tap enabled
    dwt enabled
    scroll_method two_finger
    middle_emulation enabled
}

for_window [app_id="pavucontrol"] floating enable, border normal, resize set width 40 ppt height 45 ppt, move position center
for_window [app_id="blueman-manager"] floating enable, border normal, resize set width 30 ppt height 40 ppt, move position center
for_window [app_id="satty"] floating enable, border normal, resize set width 90 ppt height 80 ppt, move position center
for_window [app_id="foot_drop"] floating enable, border normal, mark drop_term, resize set width 75 ppt height 70 ppt, move scratchpad, scratchpad show, move position center

# Locked scheme (meta/color-scheme.md).
client.focused          #5a5a5a #2d2d2d #d4d4d4 #5a5a5a #5a5a5a
client.focused_inactive #3a3a3a #202020 #8a8a8a #3a3a3a #3a3a3a
client.focused_tab_title #5a5a5a #2d2d2d #d4d4d4
client.unfocused        #3a3a3a #202020 #8a8a8a #3a3a3a #3a3a3a
# Dunst-critical treatment: urgent tint field, white text, red edges.
client.urgent           #ff7376 #4c1a1f #ffffff #ff7376 #ff7376
client.placeholder      #202020 #202020 #8a8a8a #202020 #202020
client.background       #202020

default_border pixel 1
hide_edge_borders smart

# SwayFX (static).
blur enable
blur_passes 3
blur_radius 5
blur_xray disable
shadows enable
shadow_blur_radius 14
shadow_color #00000080
shadow_offset 0 2
shadow_inactive_color #00000080
corner_radius 0
default_dim_inactive 0.05
# Must match fuzzel.ini's launcher namespace.
layer_effects "launcher" {
    shadows enable;
}

exec $HOME/.config/sway/scripts/autostart.sh

exec_always blueman-applet
exec_always nm-applet --indicator

exec awww img ~/Pictures/Wallpapers/neutral/flower-basket.jpg

bar {
    swaybar_command waybar
}

#{{ $c := .flint.resolved }}{{ $r := .flint.raw }}
#{{ $d := .flint.desktop }}

# --- Appearance (global defaults) ---
font={{ $d.font_family_nerd }} Propo {{ $d.font_size }}
edge=top
message-padding=8
button-padding=6
button-border-size=0
border-bottom-size=2
details-border-size=2

[warning]
# Bar
background={{ $r.warning_tint.hex }}
border={{ $r.warning_deep.hex }}
border-bottom={{ $r.warning_deep.hex }}
# Message text
text={{ $r.text_normal.hex }}
# Buttons
button-background={{ $r.warning_tint.hex }}
button-text={{ $r.text_normal.hex }}
# Details panel
details-background={{ $r.background_secondary_alt.hex }}

[error]
# Bar
background={{ $r.diff_delete.hex }}
border={{ $r.error.hex }}
border-bottom={{ $r.error.hex }}
# Message text
text={{ $r.text_normal.hex }}
# Buttons
button-background={{ $r.diff_delete.hex }}
button-text={{ $r.text_normal.hex }}
# Details panel
details-background={{ $r.diff_delete.hex }}

# vim: ft=dosini

# Theme: One Dark on Neutral (locked, per meta/color-scheme.md)
# One Dark Pro chromatics on the neutral-* grounds.

# --- Basic UI ---
theme[main_bg]="#202020"
theme[main_fg]="#D4D4D4"
theme[title]="#D4D4D4"
theme[hi_fg]="#61AFEF"
theme[selected_bg]="#313C45"
theme[selected_fg]="#FFFFFF"
theme[inactive_fg]="#8A8A8A"
theme[graph_text]="#8A8A8A"
theme[meter_bg]="#3A3A3A"
theme[proc_misc]="#61AFEF"

# --- Box outlines ---
theme[cpu_box]="#8A8A8A"
theme[mem_box]="#8A8A8A"
theme[net_box]="#8A8A8A"
theme[proc_box]="#8A8A8A"
theme[div_line]="#8A8A8A"

# --- Temperature graph (green -> yellow -> red) ---
theme[temp_start]="#98C379"
theme[temp_mid]="#E5C07B"
theme[temp_end]="#E06C75"

# --- CPU graph (green -> yellow -> red) ---
theme[cpu_start]="#98C379"
theme[cpu_mid]="#E5C07B"
theme[cpu_end]="#E06C75"

# --- Process list resource gradient (green -> yellow -> red) ---
theme[process_start]="#98C379"
theme[process_mid]="#E5C07B"
theme[process_end]="#E06C75"

# --- Mem/disk used & cached meters (purple -> orange -> red) ---
theme[used_start]="#C678DD"
theme[used_mid]="#D19A66"
theme[used_end]="#E06C75"
theme[cached_start]="#C678DD"
theme[cached_mid]="#D19A66"
theme[cached_end]="#E06C75"

# --- Mem/disk free & available meters (red -> orange -> purple) ---
theme[free_start]="#E06C75"
theme[free_mid]="#D19A66"
theme[free_end]="#C678DD"
theme[available_start]="#E06C75"
theme[available_mid]="#D19A66"
theme[available_end]="#C678DD"

# --- Network download/upload graphs (cyan -> blue -> bright blue) ---
theme[download_start]="#56B6C2"
theme[download_mid]="#61AFEF"
theme[download_end]="#98C3FF"
theme[upload_start]="#56B6C2"
theme[upload_mid]="#61AFEF"
theme[upload_end]="#98C3FF"

# --- Process pause & follow states ---
theme[proc_pause_bg]="#342C1C"
theme[proc_follow_bg]="#313C45"
theme[proc_banner_bg]="#3E2526"
theme[proc_banner_fg]="#D4D4D4"
theme[followed_bg]="#313C45"
theme[followed_fg]="#FFFFFF"

# Locked scheme (meta/color-scheme.md). Managed by chezmoi; edit the .tmpl
# source.{{ $p := .palette }}
{{- $mode := .mode }}
# Slot order: WindowText, Button, Light, Midlight, Dark, Mid, Text,
# BrightText, ButtonText, Base, Window, Shadow, Highlight,
# HighlightedText, Link, LinkVisited, AlternateBase, PlaceholderText,
# ToolTipBase, ToolTipText.
#
# Fusion's bevel slots are brightness-absolute: Light >= Midlight >=
# Button/Window >= Mid >= Dark >= Shadow must hold in every mode, and the
# ramp inverts per mode, so the slot mapping inverts with it. Getting this
# wrong paints raised panels (group boxes, the unlock panel) darker than
# the window in light mode.
{{- $light := "" }}{{- $midlight := "" }}{{- $chrome := "" }}{{- $mid := "" }}{{- $dark := "" }}{{- $shadow := "" }}
{{- if eq $mode "light" }}
{{- $light = $p.crust.hex }}{{- $midlight = $p.mantle.hex }}{{- $chrome = $p.surface_1.hex }}{{- $mid = $p.surface_2.hex }}{{- $dark = $p.line.hex }}{{- $shadow = $p.muted.hex }}
{{- else }}
{{- $light = $p.surface_2.hex }}{{- $midlight = $p.surface_2.hex }}{{- $chrome = $p.surface_1.hex }}{{- $mid = $p.base.hex }}{{- $dark = $p.base.hex }}{{- $shadow = $p.crust.hex }}
{{- end }}
[ColorScheme]
active_colors={{ $p.text.hex }}, {{ $chrome }}, {{ $light }}, {{ $midlight }}, {{ $dark }}, {{ $mid }}, {{ $p.text.hex }}, {{ $p.text_max.hex }}, {{ $p.text.hex }}, {{ $p.base.hex }}, {{ $chrome }}, {{ $shadow }}, {{ $p.selection_deep.hex }}, {{ $p.text_max.hex }}, {{ $p.blue.hex }}, {{ $p.purple.hex }}, {{ $p.surface_0.hex }}, {{ $p.muted.hex }}, {{ $p.surface_0.hex }}, {{ $p.text_max.hex }}
disabled_colors={{ $p.muted.hex }}, {{ $chrome }}, {{ $light }}, {{ $midlight }}, {{ $dark }}, {{ $mid }}, {{ $p.muted.hex }}, {{ $p.text_max.hex }}, {{ $p.muted.hex }}, {{ $p.base.hex }}, {{ $chrome }}, {{ $shadow }}, {{ $p.surface_2.hex }}, {{ $p.muted.hex }}, {{ $p.muted.hex }}, {{ $p.muted.hex }}, {{ $p.surface_0.hex }}, {{ $p.muted.hex }}, {{ $p.surface_0.hex }}, {{ $p.text_max.hex }}
inactive_colors={{ $p.text.hex }}, {{ $chrome }}, {{ $light }}, {{ $midlight }}, {{ $dark }}, {{ $mid }}, {{ $p.text.hex }}, {{ $p.text_max.hex }}, {{ $p.text.hex }}, {{ $p.base.hex }}, {{ $chrome }}, {{ $shadow }}, {{ $p.selection_deep.hex }}, {{ $p.text_max.hex }}, {{ $p.blue.hex }}, {{ $p.purple.hex }}, {{ $p.surface_0.hex }}, {{ $p.muted.hex }}, {{ $p.surface_0.hex }}, {{ $p.text_max.hex }}

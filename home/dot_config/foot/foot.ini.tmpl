#{{ $cd := .flint.dark.raw }}{{ $cdr := .flint.dark.resolved }}
#{{ $cl := .flint.light.raw }}{{ $clr := .flint.light.resolved }}
#{{ $d := .flint.desktop }}
#{{ $ad := .flint.dark.ansi_resolved }}
#{{ $al := .flint.light.ansi_resolved }}

font = {{ $d.font_family_nerd }} Mono:size={{ $d.font_size }}
pad = 4x4
resize-by-cells = no
initial-color-theme = {{ .flint.active_theme }}

[colors-dark]
alpha=0.9
blur = yes

foreground = {{ $cd.text_normal.bare }}
background = {{ $cd.background_primary.bare }}
# Caret follows Obsidian --caret-color: accent fill, on-accent text.
cursor = {{ $cdr.on_accent.bare }} {{ $cd.interactive_accent.bare }}
regular0 = {{ $ad.black.bare }}
regular1 = {{ $ad.red.bare }}
regular2 = {{ $ad.green.bare }}
regular3 = {{ $ad.yellow.bare }}
regular4 = {{ $ad.blue.bare }}
regular5 = {{ $ad.magenta.bare }}
regular6 = {{ $ad.cyan.bare }}
regular7 = {{ $ad.white.bare }}
bright0 = {{ $ad.bright_black.bare }}
bright1 = {{ $ad.bright_red.bare }}
bright2 = {{ $ad.bright_green.bare }}
bright3 = {{ $ad.bright_yellow.bare }}
bright4 = {{ $ad.bright_blue.bare }}
bright5 = {{ $ad.bright_magenta.bare }}
bright6 = {{ $ad.bright_cyan.bare }}
bright7 = {{ $ad.bright_white.bare }}
selection-foreground = {{ $cd.text_normal.bare }}
selection-background = {{ $cd.selection_wash.bare }}
jump-labels = {{ $cd.background_primary.bare }} {{ $cdr.jump_label_bg.bare }}
urls = {{ $cdr.text_accent.bare }}

[colors-light]
alpha=0.85
blur = yes

foreground = {{ $cl.text_normal.bare }}
background = {{ $cl.background_primary.bare }}
# Caret follows Obsidian --caret-color: accent fill, on-accent text.
cursor = {{ $clr.on_accent.bare }} {{ $cl.interactive_accent.bare }}
regular0 = {{ $al.black.bare }}
regular1 = {{ $al.red.bare }}
regular2 = {{ $al.green.bare }}
regular3 = {{ $al.yellow.bare }}
regular4 = {{ $al.blue.bare }}
regular5 = {{ $al.magenta.bare }}
regular6 = {{ $al.cyan.bare }}
regular7 = {{ $al.white.bare }}
bright0 = {{ $al.bright_black.bare }}
bright1 = {{ $al.bright_red.bare }}
bright2 = {{ $al.bright_green.bare }}
bright3 = {{ $al.bright_yellow.bare }}
bright4 = {{ $al.bright_blue.bare }}
bright5 = {{ $al.bright_magenta.bare }}
bright6 = {{ $al.bright_cyan.bare }}
bright7 = {{ $al.bright_white.bare }}
selection-foreground = {{ $cl.text_normal.bare }}
selection-background = {{ $cl.selection_wash.bare }}
jump-labels = {{ $cl.background_primary.bare }} {{ $clr.jump_label_bg.bare }}
urls = {{ $clr.text_accent.bare }}


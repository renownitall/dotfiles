// Palette comes from meta/color-scheme.md. The applied copy is generated from this template.
// {{- $p := .palette }}
themes {
    neutral {
        text_unselected {
            base "{{ $p.text.hex }}"
            background "{{ $p.base.hex }}"
            emphasis_0 "{{ $p.orange.hex }}"
            emphasis_1 "{{ $p.cyan.hex }}"
            emphasis_2 "{{ $p.green.hex }}"
            emphasis_3 "{{ $p.purple.hex }}"
        }
        text_selected {
            base "{{ $p.text.hex }}"
            background "{{ $p.surface_1.hex }}"
            emphasis_0 "{{ $p.orange.hex }}"
            emphasis_1 "{{ $p.cyan.hex }}"
            emphasis_2 "{{ $p.green.hex }}"
            emphasis_3 "{{ $p.purple.hex }}"
        }
        ribbon_selected {
            base "{{ $p.base.hex }}"
            background "{{ $p.blue.hex }}"
            emphasis_0 "{{ $p.base.hex }}"
            emphasis_1 "{{ $p.base.hex }}"
            emphasis_2 "{{ $p.base.hex }}"
            emphasis_3 "{{ $p.base.hex }}"
        }
        ribbon_unselected {

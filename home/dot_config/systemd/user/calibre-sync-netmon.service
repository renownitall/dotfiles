# Reconnect watcher; the 30-minute timer stays the fallback. Debounced in-script.

[Unit]
Description=Sync Calibre library promptly on reconnect
# Both targets listed; the one absent on a machine never loads there.
After=sway-session.target i3-session.target
PartOf=sway-session.target i3-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/calibre-sync-netmon
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=sway-session.target i3-session.target

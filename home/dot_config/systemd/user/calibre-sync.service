# One-shot upload of the Calibre library to Google Drive.
# Triggered by calibre-sync.timer (every 30 minutes) and by
# calibre-sync-netmon.service promptly on reconnect. When offline the
# script stages locally and exits cleanly without uploading.

[Unit]
Description=Mirror Calibre books flat to Google Drive

[Service]
Type=oneshot
ExecStart=%h/.local/bin/calibre-drive-sync
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=sway-session.target

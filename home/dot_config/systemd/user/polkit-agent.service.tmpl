[Unit]
Description=GNOME PolicyKit authentication agent
PartOf={{ if eq .chezmoi.hostname "optiplex" }}i3{{ else }}sway{{ end }}-session.target
After={{ if eq .chezmoi.hostname "optiplex" }}i3{{ else }}sway{{ end }}-session.target

[Service]
Type=simple
Environment=GDK_BACKEND={{ if eq .chezmoi.hostname "optiplex" }}x11{{ else }}wayland{{ end }}
ExecStart=%h/.config/{{ if eq .chezmoi.hostname "optiplex" }}i3{{ else }}sway{{ end }}/scripts/wrapper_polkit.sh
Restart=on-failure
RestartSec=1s

[Install]
WantedBy={{ if eq .chezmoi.hostname "optiplex" }}i3{{ else }}sway{{ end }}-session.target

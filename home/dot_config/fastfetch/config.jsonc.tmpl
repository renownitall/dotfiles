// Palette comes from meta/color-scheme.md. The applied copy is generated from this template.
// {{- $p := .palette }}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "disableLinewrap": true,
  },
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "{{ $p.orange.hex }}",
    },
    "padding": {
      "top": 2,
    },
  },
  "modules": [
    {
      "keyWidth": 10,
      "type": "title",
    },
    "break",
    {
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "os",
    },
    {
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "kernel",
    },
    {
      "format": "{version}",
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "host",
    },
    {
      "format": "{pacman} (pacman)",
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "packages",
    },
    {
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "shell",
    },
    {
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "terminal",
    },
    {
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "wm",
    },
    {
      "key": " ",
      "keyColor": "{{ $p.blue.hex }}",
      "type": "uptime",
    },
    "break",
    "colors",
  ],
}

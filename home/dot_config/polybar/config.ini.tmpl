; Ported from the Sway waybar config (waybar/config.jsonc + style.css).
; Colors come from the locked scheme (meta/color-scheme.md). Managed by
; chezmoi; edit the .tmpl source.{{ $p := .palette }}

[colors]
base = {{ $p.base.hex }}
text = {{ $p.text.hex }}
subtext = {{ $p.subtext.hex }}
muted = {{ $p.muted.hex }}
blue = {{ $p.blue.hex }}
red = {{ $p.red.hex }}
yellow = {{ $p.yellow.hex }}
warning-hover = {{ $p.warning_hover.hex }}

[bar/main]
width = 100%
height = 24px
radius = 0
background = ${colors.base}
foreground = ${colors.text}
border-size = 0
font-0 = SauceCodePro Nerd Font Mono:size=10;2
font-1 = SauceCodePro Nerd Font Mono:size=10:weight=bold;2
modules-left = xworkspaces i3mode custom/mpris
modules-center = xwindow
modules-right = cpu memory custom/updates separator pulseaudio systray date separator custom/dnd
cursor-click = pointer
enable-ipc = true

; Fallback spacing for every module format: waybar's shared rule is
; `margin: 1px; padding: 0 8px`. Modules with different metrics override
; these below (xworkspaces, i3mode, xwindow, systray, separator).
[settings]
screenchange-reload = true
pseudo-transparency = true
format-margin = 1px
format-padding = 8px

[module/xworkspaces]
type = internal/xworkspaces
; Waybar #workspaces: margin 0, padding 0 2px, buttons padded 6px per side;
; waybar has no scroll-to-switch, so wheel over icons must not change focus.
format-margin = 0
format-padding = 2px
enable-scroll = false
icon-0 = 1;󰲠
icon-1 = 2;󰲢
icon-2 = 3;󰲤
icon-3 = 4;󰲦
icon-4 = 5;󰲨
icon-5 = 6;󰲪
icon-6 = 7;󰲬
icon-7 = 8;󰲮
icon-8 = 9;󰲰
icon-9 = 10;󰿬
label-active = %icon%
label-active-foreground = ${colors.blue}
label-active-padding = 6px
label-occupied = %icon%
label-occupied-foreground = ${colors.muted}
label-occupied-padding = 6px
label-urgent = %icon%
label-urgent-foreground = ${colors.red}
label-urgent-padding = 6px
label-empty = %icon%
label-empty-foreground = ${colors.muted}
label-empty-padding = 6px

; Waybar sway/mode (#mode): visible only while a non-default i3 mode is
; active. With format = <label-mode> the format output is empty at rest, and
; an empty output drops its margin/padding too, so the bar is unchanged until
; a mode engages. format-margin is #mode's 4px horizontal margin (the 1px
; vertical margin and the 1px border have no polybar equivalent). The
; background covers the 8px settings-padding like the CSS box. format-font is
; 1-based: 2 selects font-1, the bold face (#mode font-weight: bold).
[module/i3mode]
type = internal/i3
format = <label-mode>
label-mode = 󰘳 %mode%
format-foreground = ${colors.yellow}
format-background = ${colors.warning-hover}
format-margin = 4px
format-font = 2

[module/xwindow]
type = internal/xwindow
; Waybar #window: padding 0 12px (margin comes from the settings fallback).
format-padding = 12px
label = %title:0:72:...%
label-foreground = ${colors.subtext}

[module/custom/mpris]
type = custom/script
exec = ~/.config/polybar/scripts/mpris.py
interval = 5
click-left = playerctl play-pause
scroll-up = playerctl next
scroll-down = playerctl previous

[module/cpu]
type = internal/cpu
interval = 5
; Format action tag: click opens btop in kitty (waybar on-click parity;
; foot is thinkpad-only).
format = %{A1:kitty -e btop:}󰻠 <label>%{A}
label = %percentage%%

[module/memory]
type = internal/memory
interval = 5
format = %{A1:kitty -e btop:}󰍛 <label>%{A}
label = %percentage_used%%

[module/custom/updates]
type = custom/script
exec = ~/.config/polybar/scripts/updates.sh
interval = 600
click-left = ~/.config/i3/scripts/toggle_topgrade.sh

[module/pulseaudio]
type = internal/pulseaudio
format-volume = %{A1:pavucontrol:}󰕾 <label-volume>%{A}
label-volume = %percentage%%
label-muted = 󰖁 Muted
label-muted-foreground = ${colors.muted}
click-right = pactl set-sink-mute @DEFAULT_SINK@ toggle

[module/systray]
type = internal/tray
; Waybar #tray: padding 0 4px, #tray > widget padding 0 6px, icon-size 12
; (50% of the 24px bar), tray spacing 12.
format-padding = 4px
tray-padding = 6px
tray-spacing = 12px
tray-size = 50%

[module/date]
type = internal/date
interval = 1
date = %Y-%m-%d %H:%M:%S
label = %date%

[module/custom/dnd]
type = custom/script
exec = ~/.config/polybar/scripts/dunst-dnd.sh
interval = 5
click-left = ~/.config/polybar/scripts/dunst-dnd.sh --toggle

; Group separator mirroring waybar's custom/separator: placed only between
; module groups, so there is no bar-level separator. Zero padding/margin
; override the settings fallback (waybar gives it no horizontal spacing).
[module/separator]
type = custom/text
format = |
format-padding = 0
format-margin = 0
format-foreground = ${colors.muted}

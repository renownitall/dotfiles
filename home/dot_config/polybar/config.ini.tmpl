; chezmoi renders this template. Colors come from meta/color-scheme.md.
; {{- $p := .palette }}
[colors]
base = {{ $p.base.hex }}
text = {{ $p.text.hex }}
subtext = {{ $p.subtext.hex }}
muted = {{ $p.muted.hex }}
blue = {{ $p.blue.hex }}
red = {{ $p.red.hex }}
yellow = {{ $p.yellow.hex }}
warning-hover = {{ $p.warning_hover.hex }}

[bar/main]
width = 100%
height = 24px
radius = 0
background = ${colors.base}
foreground = ${colors.text}
border-size = 0
font-0 = SauceCodePro Nerd Font Mono:size=10;2
font-1 = SauceCodePro Nerd Font Mono:size=10:weight=bold;2
font-2 = SauceCodePro Nerd Font Mono:style=Italic:size=10;2
modules-left = xworkspaces i3mode custom/mpris
modules-center = custom/window
modules-right = cpu memory custom/updates separator pulseaudio systray date separator custom/dnd
cursor-click = pointer
enable-ipc = true

[settings]
screenchange-reload = true
pseudo-transparency = true
format-margin = 1px
format-padding = 8px

[module/xworkspaces]
type = internal/i3
format = <label-state>
format-margin = 0
format-padding = 2px
enable-scroll = false
ws-icon-0 = 1;󰲠
ws-icon-1 = 2;󰲢
ws-icon-2 = 3;󰲤
ws-icon-3 = 4;󰲦
ws-icon-4 = 5;󰲨
ws-icon-5 = 6;󰲪
ws-icon-6 = 7;󰲬
ws-icon-7 = 8;󰲮
ws-icon-8 = 9;󰲰
ws-icon-9 = 10;󰿬
label-focused = %icon%
label-focused-foreground = ${colors.blue}
label-focused-padding = 6px
label-unfocused = %icon%
label-unfocused-foreground = ${colors.muted}
label-unfocused-padding = 6px
label-urgent = %icon%
label-urgent-foreground = ${colors.red}
label-urgent-padding = 6px

[module/i3mode]
type = internal/i3
format = <label-mode>
label-mode = 󰘳 %mode%
format-foreground = ${colors.yellow}
format-background = ${colors.warning-hover}
format-margin = 4px
format-font = 2

[module/custom/mpris]
type = custom/script
exec = ~/.config/polybar/scripts/mpris.py
tail = true
click-left = playerctl play-pause
scroll-up = playerctl next
scroll-down = playerctl previous
label-foreground = ${colors.muted}

[module/custom/window]
type = custom/script
exec = ~/.config/polybar/scripts/window_title.py
interval = 1
format-padding = 12px
label-foreground = ${colors.subtext}

[module/cpu]
type = internal/cpu
interval = 5
format = %{A1:kitty --name btop -e btop:}󰻠 <label>%{A}
label = %percentage%%

[module/memory]
type = internal/memory
interval = 5
format = %{A1:kitty --name btop -e btop:}󰍛 <label>%{A}
label = %percentage_used%%

[module/custom/updates]
type = custom/script
exec = ~/.config/polybar/scripts/updates.sh
tail = true
click-left = ~/.config/i3/scripts/toggle_topgrade.sh

[module/separator]
type = custom/text
format = |
format-padding = 0
format-margin = 0
format-foreground = ${colors.muted}

[module/pulseaudio]
type = internal/pulseaudio
format-volume = %{A1:pavucontrol:}󰕾 <label-volume>%{A}
label-volume = %percentage%%
label-muted = 󰖁 Muted
label-muted-foreground = ${colors.muted}
click-right = pactl set-sink-mute @DEFAULT_SINK@ toggle

[module/systray]
type = internal/tray
format-padding = 4px
tray-padding = 6px
tray-spacing = 6px
tray-size = 66%

[module/date]
type = internal/date
interval = 1
date = %Y-%m-%d %H:%M:%S
label = %date%

[module/custom/dnd]
type = custom/ipc
hook-0 = ~/.config/polybar/scripts/dunst-dnd.sh
initial = 1
click-left = ~/.config/polybar/scripts/dunst-dnd.sh --toggle

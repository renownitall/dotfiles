# Locked scheme (meta/color-scheme.md). Managed by chezmoi; edit the .tmpl
# source.{{ $p := .palette }}

[global]
    monitor = 0
    follow = none
    width = 340
    height = (0, 110)
    origin = top-right
    {{/* Wayland: waybar's 24px strut shifts the popups first; X11 has no
         strut awareness, so optiplex needs bar height + the same 8px. */}}
    offset = (8, {{ if eq .chezmoi.hostname "optiplex" }}32{{ else }}8{{ end }})
    notification_limit = 4
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 1
    frame_color = "{{ $p.line.hex }}"
    separator_color = frame
    sort = no
    font = SauceCodePro Nerd Font Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    icon_theme = Papirus{{ if eq .mode "light" }}-Light{{ else }}-Dark{{ end }}
    sticky_history = yes
    history_length = 50
    title = Dunst
    class = Dunst
    corner_radius = 4
    ignore_dbusclose = false
    force_xwayland = false
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all
    layer = overlay
    timeout = 5

[urgency_low]
    background = "{{ $p.surface_1.hex }}"
    foreground = "{{ $p.text.hex }}"
    frame_color = "{{ $p.line.hex }}"
    timeout = 3

[urgency_normal]
    background = "{{ $p.notice.hex }}"
    foreground = "{{ $p.text_max.hex }}"
    frame_color = "{{ $p.blue_bright.hex }}"
    timeout = 5

[urgency_critical]
    background = "{{ $p.urgent.hex }}"
    foreground = "{{ $p.text_max.hex }}"
    frame_color = "{{ $p.red_bright.hex }}"
    timeout = 0

[dnd_bypass_dunst_dnd]
    appname = dunst-dnd
    override_pause_level = 90

[dnd_bypass_caffeine]
    appname = caffeine-toggle
    override_pause_level = 90

# sw is the wallpaper tool. Its notices carry appname "sw".
[dnd_bypass_wallpaper]
    appname = sw
    override_pause_level = 90

[dnd_bypass_idle_warning]
    appname = idle-warning
    override_pause_level = 90

[dnd_bypass_lock]
    appname = lock
    override_pause_level = 90

[dnd_bypass_screenshot]
    appname = screenshot
    override_pause_level = 90

# Locked scheme (meta/color-scheme.md); gradient walks the chromatic ladder.
# Managed by chezmoi; edit the .tmpl source.{{ $p := .palette }}

[general]
live-config = 1
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
xaxis = none
synchronized_sync = 0
show_idle_bar_heads = 0
waveform = 0

[color]

background = '{{ $p.base.hex }}'
foreground = '{{ $p.blue.hex }}'

gradient = 1
gradient_color_1 = '{{ $p.blue.hex }}'
gradient_color_2 = '{{ $p.cyan.hex }}'
gradient_color_3 = '{{ $p.green.hex }}'
gradient_color_4 = '{{ $p.yellow.hex }}'
gradient_color_5 = '{{ $p.orange.hex }}'
gradient_color_6 = '{{ $p.red.hex }}'
gradient_color_7 = '{{ $p.purple.hex }}'
gradient_color_8 = '{{ $p.purple_bright.hex }}'

horizontal_gradient = 0

[smoothing]
monstercat = 0
waves = 0
noise_reduction = 77

# vim: ft=dosini

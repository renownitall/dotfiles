#!/usr/bin/env sh
set -eu

# chezmoi:template:left-delimiter="'{{" right-delimiter="}}'"
#'{{ $a := .flint.appearance }}'
#'{{ $d := .flint.desktop }}'
#'{{ $theme := .flint.active_theme }}'
# Re-run when the notification daemon config changes, not just when this
# script does. Chezmoi run_onchange_ hashes the script body only.
# dunstrc content hash:
# '{{ include "dot_config/dunst/dunstrc.tmpl" | sha256sum }}'

COLOR_SCHEME='{{ $a.color_scheme }}'
GTK_THEME='{{ $a.gtk_theme }}'
ICON_THEME='{{ $a.icon_theme }}'
WALLPAPER='{{ $a.wallpaper }}'
THEME='{{ $theme }}'
FONT_NAME="'{{ $d.font_family_sans }}' '{{ $d.font_size }}'"
MONO_FONT_NAME="'{{ $d.font_family }}' '{{ $d.font_size }}'"
DOCUMENT_FONT_NAME="'{{ $d.font_family_sans }}' '{{ $d.font_size }}'"
CURSOR_THEME='{{ $d.cursor_theme }}'
CURSOR_SIZE='{{ $d.cursor_size }}'

# Apply GTK / Desktop interface preferences (hot-reload for GTK 3/4 via
# GSettings; .gtkrc-2.0 and gtk-3.0/gtk-4.0/settings.ini are also templated
# and updated by chezmoi)
if command -v gsettings >/dev/null 2>&1; then
	gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME" || true
	gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" || true
	gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" || true
	gsettings set org.gnome.desktop.interface font-name "$FONT_NAME" || true
	gsettings set org.gnome.desktop.interface document-font-name "$DOCUMENT_FONT_NAME" || true
	gsettings set org.gnome.desktop.interface monospace-font-name "$MONO_FONT_NAME" || true
	gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME" || true
	gsettings set org.gnome.desktop.interface cursor-size "$CURSOR_SIZE" || true
fi

# Reload the notification daemon whenever it answers on the bus, whether or
# not it runs under its systemd unit. Fall back to a unit restart only when
# the daemon is silent but the unit claims to be active.
if command -v dunstctl >/dev/null 2>&1; then
	if dunstctl reload 2>/dev/null; then
		:
	elif command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet dunst.service 2>/dev/null; then
		systemctl --user restart dunst.service || true
	fi
fi

# Reload Sway configuration
if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
	swaymsg reload || true
fi

# Apply themed wallpaper (expand a leading tilde safely in POSIX sh)
expand_tilde() {
	case "$1" in
	"~"/*) printf '%s/%s' "$HOME" "${1#~/}" ;;
	"~") printf '%s' "$HOME" ;;
	*) printf '%s' "$1" ;;
	esac
}
WALLPAPER_PATH=$(expand_tilde "$WALLPAPER")

# Prefer the last wallpaper used in this theme's rotation, falling back
# to the theme's default wallpaper.
LAST_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper_last_$THEME"
if [ -s "$LAST_FILE" ]; then
	LAST_WALLPAPER=$(sed -n '1p' "$LAST_FILE") || true
	if [ -n "$LAST_WALLPAPER" ]; then
		WALLPAPER_PATH=$(expand_tilde "$LAST_WALLPAPER") || true
	fi
fi

if [ -n "$WALLPAPER_PATH" ] && [ -f "$WALLPAPER_PATH" ] && command -v flint-wallpaper >/dev/null 2>&1; then
	flint-wallpaper --theme "$THEME" --set "$WALLPAPER_PATH" || true
fi

# vim: ft=sh

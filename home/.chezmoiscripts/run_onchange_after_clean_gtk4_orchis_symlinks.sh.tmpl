#!/usr/bin/env sh
set -eu

# chezmoi:template:left-delimiter="'{{" right-delimiter="}}'"
#'{{ $a := .flint.appearance }}'
# Data-file GTK theme (fallback): '{{ $a.gtk_theme }}'

# Remove Orchis installer symlinks from ~/.config/gtk-4.0 when they point at a
# variant that differs from the active GTK theme. Orchis's install.sh -l links
# gtk.css/gtk-dark.css/assets into ~/.config/gtk-4.0 so every GTK4 app uses
# that variant's colors, overriding the active theme. Links that match the
# active theme are kept, and links that do not point at an Orchis theme are
# never touched.

gtk4_dir="${HOME}/.config/gtk-4.0"
[ -d "$gtk4_dir" ] || exit 0

# Active GTK theme, in priority order: live gsettings value, the theme baked
# into this script's data, then the freshly applied gtk-4.0 settings.ini.
gtk_theme=""
if command -v gsettings >/dev/null 2>&1; then
	gtk_theme=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || true)
	gtk_theme=${gtk_theme#\'}
	gtk_theme=${gtk_theme%\'}
fi
[ -n "$gtk_theme" ] || gtk_theme='{{ $a.gtk_theme }}'
[ -n "$gtk_theme" ] || gtk_theme=$(sed -n 's/^gtk-theme-name=//p' "$gtk4_dir/settings.ini" 2>/dev/null | head -n 1)

[ -n "$gtk_theme" ] || exit 0

for name in gtk.css gtk-dark.css assets; do
	link="$gtk4_dir/$name"
	[ -L "$link" ] || continue
	target=$(readlink "$link") || continue
	case "$target" in
	*/themes/Orchis-*)
		variant=${target%/gtk-4.0/*}
		variant=${variant##*/}
		if [ "$variant" != "$gtk_theme" ]; then
			rm "$link"
			echo "removed stale Orchis symlink: $link -> $target"
		fi
		;;
	esac
done

# vim: ft=sh

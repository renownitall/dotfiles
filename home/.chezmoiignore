# Generated caches and tooling that must never be managed by chezmoi.
__pycache__/
.mypy_cache/
.ruff_cache/

# Generated per machine by ~/.local/bin/wlsunset-location; machine-local
# state, never deployed or committed.
.config/wlsunset.env

# Per-machine file sets. thinkpad runs Sway on Wayland; optiplex runs i3 on
# X11. Each machine ignores the other machine's window manager, its apps,
# and the session units that start them.
{{ if eq .chezmoi.hostname "optiplex" }}
.config/sway
.config/foot
.config/fuzzel
.config/swaylock
.config/waybar
.config/systemd/user/awww-daemon.service
.config/systemd/user/sway-session.target
.config/systemd/user/sway-session.target.wants
.config/systemd/user/swayidle-unlocked.service
.config/systemd/user/swayidle-locked.service
# optiplex's Calibre library differs from thinkpad's and gets no rclone
# config, so the gdrive sync never runs here.
.config/systemd/user/calibre-sync.service
.config/systemd/user/calibre-sync.timer
.config/systemd/user/calibre-sync-netmon.service
# wlsunset-env.service stays deployed here too: redshift.service Wants it
# to generate the machine-local location env file on optiplex.
.config/systemd/user/wlsunset.service
{{ else if eq .chezmoi.hostname "thinkpad" }}
.config/i3
.config/kitty
.config/rofi
.config/polybar
.config/picom.conf
.config/systemd/user/i3-session.target
.config/systemd/user/i3-session.target.wants
.config/systemd/user/redshift.service
{{ end }}

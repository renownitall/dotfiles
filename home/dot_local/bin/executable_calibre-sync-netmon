#!/usr/bin/env sh
set -eu

# Sync soon after reconnect; the 30-minute timer stays the fallback.
# Debounced so flapping Wi-Fi can't hammer Drive. Exit 1 when nmcli is missing.

COOLDOWN_SEC=120
SETTLE_SEC=10
STAMP="${XDG_CACHE_HOME:-$HOME/.cache}/calibre-drive-sync/last-net-trigger"

if ! command -v nmcli >/dev/null 2>&1; then
	echo "calibre-sync-netmon: nmcli not found" >&2
	exit 1
fi

mkdir -p "$(dirname "$STAMP")"
# No login sync; the timer's Persistent=true already covers catch-up.
touch "$STAMP"

should_trigger() {
	if [ -f "$STAMP" ]; then
		last=$(stat -c %Y "$STAMP" 2>/dev/null || echo 0)
		now=$(date +%s)
		if [ $((now - last)) -lt "$COOLDOWN_SEC" ]; then
			return 1
		fi
	fi
	if systemctl --user is-active --quiet calibre-sync.service 2>/dev/null; then
		return 1
	fi
	if [ "$(nmcli networking connectivity check 2>/dev/null || echo none)" != "full" ]; then
		return 1
	fi
	return 0
}

# nmcli monitor blocks; restart if it ever exits (NM restarted).
while true; do
	nmcli monitor 2>/dev/null | while IFS= read -r line; do
		case "$line" in
		*full* | *connected* | *connectivity*)
			sleep "$SETTLE_SEC"
			if should_trigger; then
				touch "$STAMP"
				echo "network reconnected; starting calibre-sync.service"
				systemctl --user start calibre-sync.service || true
			else
			# One sync per burst, not one per NM line.
				touch "$STAMP"
			fi
			;;
		esac
	done
	sleep 10
done

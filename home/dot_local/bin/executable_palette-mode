#!/usr/bin/env bash
# Prints, records, or toggles the machine's palette mode. Recording a mode
# is best done through the repo Makefile from anywhere:
#
#   make light   # or: make dark
#
# which records the mode file, regenerates the palette, and applies (the
# run_onchange hook then applies dconf, re-renders the wallpaper, and
# reloads the session). A fresh clone must run `make palette` once before
# `chezmoi apply`.
#
# `toggle` flips to the other mode through that same pipeline; the session
# configs bind it to a key. Prints the current mode when called without
# arguments.

set -euo pipefail

state_file="$HOME/.local/state/palette-mode"

current_mode() {
	if [ -f "$state_file" ]; then
		cat "$state_file"
	else
		echo dark
	fi
}

case "${1:-}" in
"")
	current_mode
	exit 0
	;;
dark | light)
	mode=$1
	;;
toggle)
	if [ "$(current_mode)" = dark ]; then
		mode=light
	else
		mode=dark
	fi
	;;
*)
	echo "usage: palette-mode [dark|light|toggle]" >&2
	exit 2
	;;
esac

# The Makefile records the mode; make sure its state directory exists first.
mkdir -p "${state_file%/*}"

# One switch at a time: while a switch is applying, another invocation (a
# repeated keypress, say) exits instead of racing the running one.
exec 9>"${state_file}.lock"
flock -n 9 || {
	echo "palette-mode: another mode switch is running" >&2
	exit 1
}

# The checkout, not chezmoi source-path: source-path resolves into home/
# (.chezmoiroot), while the Makefile lives at the repo root.
# A keypress has no terminal output, so the outcome shows up on the desktop.
cd "$HOME/.local/share/chezmoi" && make "${mode}" || {
	status=$?
	dunstify -a palette-mode -u critical "Palette mode" \
		"Switch to ${mode} failed." >/dev/null 2>&1 || true
	exit "$status"
}

dunstify -a palette-mode -u normal "Palette mode" \
	"Switched to ${mode} mode." >/dev/null 2>&1 || true

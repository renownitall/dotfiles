#!/usr/bin/env bash

set -euo pipefail

state_file="$HOME/.local/state/palette-mode"

current_mode() {
	if [ -f "$state_file" ]; then
		cat "$state_file"
	else
		echo dark
	fi
}

case "${1:-}" in
"")
	current_mode
	exit 0
	;;
dark | light)
	mode=$1
	;;
toggle)
	if [ "$(current_mode)" = dark ]; then
		mode=light
	else
		mode=dark
	fi
	;;
*)
	echo "usage: palette-mode [dark|light|toggle]" >&2
	exit 2
	;;
esac

mkdir -p "${state_file%/*}"

exec 9>"${state_file}.lock"
flock -n 9 || {
	echo "palette-mode: another mode switch is running" >&2
	exit 1
}

cd "$HOME/.local/share/chezmoi" && make "${mode}" 9>&- || {
	status=$?
	dunstify -a palette-mode -u critical "Palette mode" \
		"Switch to ${mode} failed." >/dev/null 2>&1 || true
	exit "$status"
}

dunstify -a palette-mode -u normal "Palette mode" \
	"Switched to ${mode} mode." >/dev/null 2>&1 || true

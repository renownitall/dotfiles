#!/usr/bin/env python3
"""
Flint wallpaper themer.

Applies a lutgen-generated color LUT to one or more images, caching both the
LUT and each rendered output so repeated runs are cheap. Optionally sets the
final themed image as the wallpaper via awww or swww.
"""

from __future__ import annotations

import argparse
import hashlib
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

VALID_THEMES = ("dark", "light")
HASH_CHUNK_SIZE = 1024 * 1024
CHEZMOI_TIMEOUT_SECONDS = 10

# --- ``awww img`` parameters ---
# The definitive reference is awww-img(1).
TRANSITION_DURATION = 0.6
TRANSITION_TYPE = "random"

PROFILE_DEFAULTS = {
    "PALETTE": ("flint", "flint"),
    "LUM": ("1.05", "1.05"),
    "RADIUS": ("8.0", "8.0"),
    "SHAPE": ("96.0", "96.0"),
    "PRESERVE": ("1", "1"),
}

PALETTE_ALIASES = {
    "flint": "flint",
    "cool": "flint-cool",
    "flint-cool": "flint-cool",
    "warm": "flint-warm",
    "flint-warm": "flint-warm",
}

FLINT_SECTION_RE = re.compile(r"^(?P<indent> *)flint:\s*(?:#.*)?$")
ACTIVE_THEME_RE = re.compile(
    r"""^\s*active_theme:\s*(?P<quote>['"]?)(?P<theme>dark|light)"""
    r"""(?P=quote)\s*(?:#.*)?$"""
)


@dataclass(frozen=True)
class RenderConfig:
    """Resolved rendering settings for the selected theme."""

    theme: str
    palette: str
    lum: str
    radius: str
    shape: str
    rbf: bool
    preserve: bool

    @property
    def algorithm_tag(self) -> str:
        if self.rbf:
            return f"rbf-shape-{self.shape}"
        return f"blur-radius-{self.radius}"


@dataclass(frozen=True)
class PaletteSource:
    """Information needed to invoke and cache a lutgen palette."""

    argument: str
    identity: str
    content_hash: str


def warn(message: str) -> None:
    print(f"warning: {message}", file=sys.stderr)


def die(message: str) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def expand_user_path(path: Path) -> Path:
    """Expand a leading tilde without failing for unknown users."""

    return Path(os.path.expanduser(os.fspath(path)))


def text_hash(text: str, length: int) -> str:
    digest = hashlib.sha256(text.encode("utf-8", errors="surrogateescape"))
    return digest.hexdigest()[:length]


def file_content_hash(path: Path, length: int) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        while chunk := file.read(HASH_CHUNK_SIZE):
            digest.update(chunk)
    return digest.hexdigest()[:length]


def file_sig_hash(path: Path, length: int = 12) -> str:
    """Hash stable file metadata without reading potentially large content."""

    try:
        resolved_path = str(path.resolve())
    except (OSError, RuntimeError):
        resolved_path = str(path)

    stat = path.stat()
    signature = "\0".join(
        (
            resolved_path,
            str(stat.st_dev),
            str(stat.st_ino),
            str(stat.st_size),
            str(stat.st_mtime_ns),
            str(stat.st_ctime_ns),
        )
    )
    return text_hash(signature, length)


def is_nonempty_file(path: Path) -> bool:
    try:
        return path.is_file() and path.stat().st_size > 0
    except (OSError, RuntimeError):
        return False


def _read_theme_without_yaml(text: str) -> str | None:
    """Extracts flint.active_theme from the expected generated YAML layout."""

    lines = text.splitlines()

    for index, line in enumerate(lines):
        section_match = FLINT_SECTION_RE.match(line)
        if not section_match:
            continue

        section_indent = len(section_match.group("indent"))

        for child_line in lines[index + 1 :]:
            stripped = child_line.strip()
            if not stripped or stripped.startswith("#"):
                continue

            child_indent = len(child_line) - len(child_line.lstrip(" "))
            if child_indent <= section_indent:
                break

            theme_match = ACTIVE_THEME_RE.match(child_line)
            if theme_match:
                return theme_match.group("theme")

    return None


def read_theme_from_data_file(path: Path) -> str | None:
    """Reads flint.active_theme from a chezmoi data file.

    PyYAML is preferred when available. A targeted parser is used otherwise
    because the data file is machine-generated with a stable structure and
    system Python installations may not include PyYAML.
    """

    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None

    try:
        import yaml
    except ImportError:
        return _read_theme_without_yaml(text)

    try:
        data = yaml.safe_load(text)
    except yaml.YAMLError:
        return None

    if not isinstance(data, dict):
        return None

    flint = data.get("flint")
    if not isinstance(flint, dict):
        return None

    theme = flint.get("active_theme")
    return theme if theme in VALID_THEMES else None


def resolve_chezmoi_data_file(
    env: Mapping[str, str],
) -> Path | None:
    """Locate the active chezmoi data file."""

    env_data = env.get("FLINT_CHEZMOI_DATA")
    if env_data:
        candidate = expand_user_path(Path(env_data))
        if candidate.is_file():
            return candidate

    chezmoi = shutil.which("chezmoi")
    if chezmoi:
        try:
            process = subprocess.run(
                [chezmoi, "source-path"],
                capture_output=True,
                text=True,
                check=True,
                timeout=CHEZMOI_TIMEOUT_SECONDS,
            )
        except (
            OSError,
            subprocess.CalledProcessError,
            subprocess.TimeoutExpired,
        ):
            source_root = ""
        else:
            source_root = process.stdout.strip()

        if source_root:
            candidate = expand_user_path(Path(source_root)) / ".chezmoidata.yaml"
            if candidate.is_file():
                return candidate

    xdg_data_raw = env.get("XDG_DATA_HOME")
    xdg_data = (
        expand_user_path(Path(xdg_data_raw))
        if xdg_data_raw
        else Path.home() / ".local" / "share"
    )
    default_data = Path.home() / ".local" / "share"

    candidates = [
        xdg_data / "chezmoi" / ".chezmoidata.yaml",
        default_data / "chezmoi" / ".chezmoidata.yaml",
    ]

    seen = set()
    for candidate in candidates:
        candidate_key = os.fspath(candidate)
        if candidate_key in seen:
            continue
        seen.add(candidate_key)

        if candidate.is_file():
            return candidate

    return None


def determine_theme(
    requested: str,
    data_theme: str | None,
    env: Mapping[str, str],
) -> str:
    if requested in VALID_THEMES:
        return requested

    if requested != "auto":
        die(f"invalid theme '{requested}' (expected: auto, dark, or light)")

    env_theme = env.get("FLINT_THEME", "")
    if env_theme:
        if env_theme in VALID_THEMES:
            return env_theme
        warn(f"ignoring invalid FLINT_THEME='{env_theme}'")

    return data_theme or "dark"


def profile_env_value(
    env: Mapping[str, str],
    setting: str,
    theme: str,
) -> str:
    dark_default, light_default = PROFILE_DEFAULTS[setting]
    dark_value = env.get(
        f"FLINT_WALLPAPER_{setting}_DARK",
        dark_default,
    )
    light_value = env.get(
        f"FLINT_WALLPAPER_{setting}_LIGHT",
        light_default,
    )
    return light_value if theme == "light" else dark_value


def resolve_palette_alias(name: str, balanced_palette: str) -> str:
    if name == "balanced":
        return balanced_palette
    return PALETTE_ALIASES.get(name, name)


def normalize_number(name: str, value: str) -> str:
    try:
        number = float(value)
    except (TypeError, ValueError):
        die(f"{name} must be a number, got: {value!r}")

    if not math.isfinite(number):
        die(f"{name} must be a finite number, got: {value!r}")

    return repr(number)


def resolve_render_config(
    args: argparse.Namespace,
    theme: str,
    env: Mapping[str, str],
) -> RenderConfig:
    palette_default = profile_env_value(env, "PALETTE", theme)
    palette = resolve_palette_alias(args.palette, palette_default)
    if not palette:
        die("palette must not be empty")

    lum_raw = args.lum if args.lum is not None else profile_env_value(env, "LUM", theme)
    radius_raw = (
        args.radius
        if args.radius is not None
        else profile_env_value(env, "RADIUS", theme)
    )
    shape_raw = (
        args.shape if args.shape is not None else profile_env_value(env, "SHAPE", theme)
    )

    lum = normalize_number("lum", lum_raw)
    radius = radius_raw if args.rbf else normalize_number("radius", radius_raw)
    shape = normalize_number("shape", shape_raw) if args.rbf else shape_raw

    if not args.rbf and args.shape is not None:
        warn("--shape is ignored unless --rbf is used")
    if args.rbf and args.radius is not None:
        warn("--radius is ignored when --rbf is used")

    if args.preserve is None:
        preserve_raw = profile_env_value(env, "PRESERVE", theme)
    else:
        preserve_raw = "1" if args.preserve else "0"

    if preserve_raw not in ("0", "1"):
        die("preserve must resolve to 0 or 1")

    preserve = preserve_raw == "1"
    if args.rbf and preserve:
        warn(
            "lutgen cannot combine preserve mode with Gaussian RBF; disabling preserve"
        )
        preserve = False

    return RenderConfig(
        theme=theme,
        palette=palette,
        lum=lum,
        radius=radius,
        shape=shape,
        rbf=args.rbf,
        preserve=preserve,
    )


def is_explicit_palette_path(palette: str) -> bool:
    if Path(palette).is_absolute() or palette.startswith("~"):
        return True
    if os.sep in palette:
        return True
    return bool(os.altsep and os.altsep in palette)


def palette_cache_target(lutgen_dir: Path, palette: str) -> Path:
    if is_explicit_palette_path(palette):
        return expand_user_path(Path(palette))
    return lutgen_dir / palette


def resolve_palette_source(
    lutgen_dir: Path,
    palette: str,
) -> PaletteSource:
    explicit_path = is_explicit_palette_path(palette)
    target = palette_cache_target(lutgen_dir, palette)

    if target.is_file():
        try:
            content_hash = file_content_hash(target, 12)
        except OSError as exc:
            die(f"could not read palette file {target}: {exc}")

        try:
            identity = str(target.resolve())
        except (OSError, RuntimeError):
            identity = str(target)

        return PaletteSource(
            argument=str(target) if explicit_path else palette,
            identity=identity,
            content_hash=content_hash,
        )

    if explicit_path:
        die(f"palette file not found: {target}")

    if palette.startswith("flint"):
        die(
            f"palette file not found: {target}\n"
            "(run 'chezmoi apply' to render the lutgen palettes, "
            "or pass an explicit lutgen palette name/path)"
        )

    return PaletteSource(
        argument=palette,
        identity=palette,
        content_hash="builtin",
    )


def ensure_directory(path: Path, description: str) -> None:
    try:
        if path.exists() and not path.is_dir():
            die(f"{description} exists and is not a directory: {path}")
        path.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        die(f"could not create {description} {path}: {exc}")


def build_output_path(
    output_dir: Path,
    theme: str,
    render_hash: str,
    image: Path,
) -> Path:
    source_hash = file_sig_hash(image)
    stem = image.stem if image.suffix else image.name
    filename = f"{stem}.{theme}.{source_hash}.{render_hash}{image.suffix}"
    return output_dir / filename


def generate_lut(
    lutgen: str,
    palette: PaletteSource,
    config: RenderConfig,
    lut_file: Path,
) -> None:
    print(f"Generating LUT [{config.theme}]: {lut_file}", file=sys.stderr)

    try:
        with tempfile.TemporaryDirectory(
            prefix=".flint-lut-",
            dir=lut_file.parent,
        ) as temp_dir:
            temporary_lut = Path(temp_dir) / lut_file.name
            command = [
                lutgen,
                "generate",
                "-p",
                palette.argument,
                "-L",
                config.lum,
                "-o",
                str(temporary_lut),
            ]

            if config.rbf:
                command.extend(("-R", "-s", config.shape))
            else:
                command.extend(("-r", config.radius))

            if config.preserve:
                command.append("-P")

            command.append("--")
            subprocess.run(command, check=True)

            if not is_nonempty_file(temporary_lut):
                die("lutgen generate completed without creating a valid LUT")

            os.replace(temporary_lut, lut_file)
    except subprocess.CalledProcessError as exc:
        die(f"lutgen generate failed (exit status {exc.returncode})")
    except OSError as exc:
        die(f"could not generate LUT: {exc}")


def apply_lut(
    lutgen: str,
    lut_file: Path,
    image: Path,
    output_file: Path,
) -> bool:
    try:
        with tempfile.TemporaryDirectory(
            prefix=".flint-render-",
            dir=output_file.parent,
        ) as temp_dir:
            work_dir = Path(temp_dir)
            subprocess.run(
                [
                    lutgen,
                    "apply",
                    "-d",
                    "--hald-clut",
                    str(lut_file),
                    "-o",
                    str(work_dir),
                    str(image),
                    "--",
                ],
                check=True,
            )

            expected_output = work_dir / image.name
            if is_nonempty_file(expected_output):
                generated = expected_output
            else:
                generated_files = sorted(
                    (path for path in work_dir.iterdir() if is_nonempty_file(path)),
                    key=lambda path: path.name,
                )

                if not generated_files:
                    warn(f"could not determine output file for: {image}")
                    return False

                if len(generated_files) > 1:
                    warn(f"lutgen produced multiple unexpected files for: {image}")
                    return False

                generated = generated_files[0]

            os.replace(generated, output_file)
    except subprocess.CalledProcessError as exc:
        warn(f"lutgen apply failed for {image} (exit status {exc.returncode})")
        return False
    except OSError as exc:
        warn(f"could not theme {image}: {exc}")
        return False

    return True


def set_wallpaper(path: Path) -> bool:
    for command_name in ("awww", "swww"):
        executable = shutil.which(command_name)
        if not executable:
            continue

        try:
            subprocess.run(
                [
                    executable,
                    "img",
                    str(path),
                    f"--transition-duration={TRANSITION_DURATION}",
                    f"--transition-type={TRANSITION_TYPE}",
                ],
                check=True,
            )
        except subprocess.CalledProcessError as exc:
            warn(
                f"{command_name} failed to set wallpaper (exit status {exc.returncode})"
            )
            return False
        except OSError as exc:
            warn(f"could not run {command_name}: {exc}")
            return False

        return True

    warn("no awww or swww binary found; not setting wallpaper")
    return False


ENV_HELP = """\
theme-aware environment overrides:
  FLINT_THEME=dark|light
  FLINT_CHEZMOI_DATA=/path/to/.chezmoidata.yaml
  FLINT_WALLPAPER_PALETTE_DARK=...
  FLINT_WALLPAPER_PALETTE_LIGHT=...
  FLINT_WALLPAPER_LUM_DARK=...
  FLINT_WALLPAPER_LUM_LIGHT=...
  FLINT_WALLPAPER_RADIUS_DARK=...
  FLINT_WALLPAPER_RADIUS_LIGHT=...
  FLINT_WALLPAPER_SHAPE_DARK=...
  FLINT_WALLPAPER_SHAPE_LIGHT=...
  FLINT_WALLPAPER_PRESERVE_DARK=0|1
  FLINT_WALLPAPER_PRESERVE_LIGHT=0|1

examples:
  flint-wallpaper --set ~/Pictures/Wallpapers/ghibli.jpg
  flint-wallpaper --theme light --set ~/Pictures/Wallpapers/ghibli.jpg
  flint-wallpaper --palette cool --lum 1.1 --set ~/Pictures/ghibli.jpg
  flint-wallpaper --theme auto --palette balanced ~/Pictures/Wallpapers/*.jpg
  flint-wallpaper --rbf --shape 96.0 --set ~/Pictures/Wallpapers/river.jpg
"""


def parse_args(
    argv: Sequence[str] | None = None,
) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="flint-wallpaper",
        description="Theme wallpapers with lutgen, caching LUTs and outputs.",
        epilog=ENV_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-t",
        "--theme",
        choices=("auto", *VALID_THEMES),
        default="auto",
        help="theme profile: auto | dark | light (default: auto)",
    )
    parser.add_argument(
        "-p",
        "--palette",
        default="balanced",
        help=(
            "palette: balanced | flint | cool | warm, or any value passed "
            "directly to lutgen (default: balanced)"
        ),
    )
    parser.add_argument(
        "-l",
        "--lum",
        help="luminosity factor (default: theme profile)",
    )
    parser.add_argument(
        "-r",
        "--radius",
        help="Gaussian blur radius (default: theme profile; ignored with --rbf)",
    )
    parser.add_argument(
        "--rbf",
        action="store_true",
        help="use Gaussian RBF instead of blur (disables preserve automatically)",
    )
    parser.add_argument(
        "-s",
        "--shape",
        help="Gaussian RBF shape (only with --rbf; default: theme profile)",
    )
    parser.add_argument(
        "--no-preserve",
        dest="preserve",
        action="store_false",
        default=None,
        help="do not preserve original luminosity/contrast",
    )
    parser.add_argument(
        "--refresh",
        action="store_true",
        help="regenerate the cached LUT and reapply even if outputs exist",
    )
    parser.add_argument(
        "-o",
        "--output-dir",
        type=Path,
        help="output directory (default: ~/.cache/flint/wallpapers/<theme>)",
    )
    parser.add_argument(
        "--set",
        dest="set_wallpaper",
        action="store_true",
        help="set the final themed image as wallpaper via awww or swww",
    )
    parser.add_argument(
        "images",
        nargs="+",
        type=Path,
        metavar="image",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    env = os.environ

    lutgen = shutil.which("lutgen")
    if not lutgen:
        die("lutgen not found in PATH")

    data_file = resolve_chezmoi_data_file(env)
    data_theme = read_theme_from_data_file(data_file) if data_file is not None else None
    theme = determine_theme(args.theme, data_theme, env)
    config = resolve_render_config(args, theme, env)

    if config.palette == "flint" and data_theme is not None and theme != data_theme:
        warn(
            f"requested theme '{theme}' but live lutgen palette is "
            f"'{data_theme}' (from {data_file}); colors will not match until "
            f"you rebuild with --theme {theme}"
        )

    xdg_cache_raw = env.get("XDG_CACHE_HOME")
    xdg_cache = (
        expand_user_path(Path(xdg_cache_raw))
        if xdg_cache_raw
        else Path.home() / ".cache"
    )

    output_dir = (
        expand_user_path(args.output_dir)
        if args.output_dir is not None
        else xdg_cache / "flint" / "wallpapers" / theme
    )

    lutgen_dir_raw = env.get("LUTGEN_DIR")
    lutgen_dir = (
        expand_user_path(Path(lutgen_dir_raw))
        if lutgen_dir_raw
        else Path.home() / ".config" / "lutgen"
    )

    palette = resolve_palette_source(lutgen_dir, config.palette)

    lut_dir = xdg_cache / "flint" / "luts" / theme
    ensure_directory(lut_dir, "LUT cache directory")
    ensure_directory(output_dir, "output directory")

    try:
        lutgen_hash = file_sig_hash(Path(lutgen), 16)
    except OSError as exc:
        warn(f"could not inspect lutgen executable: {exc}")
        lutgen_hash = text_hash(lutgen, 16)

    lut_signature = "\0".join(
        (
            f"theme={config.theme}",
            f"palette={config.palette}",
            f"palette_identity={palette.identity}",
            f"palette_hash={palette.content_hash}",
            f"algorithm={config.algorithm_tag}",
            f"lum={config.lum}",
            f"preserve={int(config.preserve)}",
            f"lutgen={lutgen_hash}",
        )
    )
    lut_id = text_hash(lut_signature, 16)
    lut_file = lut_dir / f"{lut_id}.png"

    if args.refresh or not is_nonempty_file(lut_file):
        generate_lut(lutgen, palette, config, lut_file)

    try:
        lut_content_hash = file_content_hash(lut_file, 16)
    except OSError as exc:
        die(f"could not read cached LUT {lut_file}: {exc}")

    render_hash = text_hash(
        f"{lut_content_hash}\0{lutgen_hash}",
        16,
    )

    last_output: Path | None = None
    had_error = False

    for image_arg in args.images:
        image = expand_user_path(image_arg)

        if not image.is_file():
            warn(f"skipping missing file: {image_arg}")
            had_error = True
            continue

        try:
            output_file = build_output_path(
                output_dir,
                theme,
                render_hash,
                image,
            )
        except OSError as exc:
            warn(f"could not inspect source image {image}: {exc}")
            had_error = True
            continue

        if not args.refresh and is_nonempty_file(output_file):
            print(output_file)
            last_output = output_file
            continue

        if apply_lut(lutgen, lut_file, image, output_file):
            print(output_file)
            last_output = output_file
        else:
            had_error = True

    if args.set_wallpaper:
        if last_output is None:
            warn("no themed image is available to set as wallpaper")
            had_error = True
        elif not set_wallpaper(last_output):
            had_error = True

    return 1 if had_error else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)

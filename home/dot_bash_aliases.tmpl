alias cat='bat --theme=ansi'
alias ff='fastfetch'
alias g='git'
alias grep='grep --color=auto'
alias lg='lazygit'
alias ls='ls --color=auto --human-readable'
alias v='${EDITOR:-nvim}'
alias ze='zellij'

alias ll='ls -lAhF'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -lhtr'
alias lS='ls -lhSr'
alias ldir='ls -d */'

alias c='clear'
alias h='history'
alias hdel='rm -vi $HOME/.bash_history && exec $SHELL'
alias myip='curl -s ifconfig.me'
alias sha='shasum -a 256'
alias helpalias='echo "--- ALL ALIASES ---" && alias | sort'

alias cz='chezmoi'
alias czp='chezmoi apply && exec $SHELL'
alias cze='chezmoi edit'
alias czc='cd {{ .chezmoi.workingTree }}'

bak() { cp -v "$1" "$1.bak.$(date +%Y%m%d_%H%M%S)"; }

# vim: ft=sh
